  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "HOJA 3 - DIARIO DEL BIBLIOTECARIO\n\nViernes.\n\nClasifiqu\xE9 \"seis\"
    tesis que hab\xEDan sido dejadas en el dep\xF3sito. Mientras las ordenaba, escuch\xE9
    a unos alumnos discutir sobre qui\xE9n gan\xF3 las elecciones de hace a\xF1os.
    Incre\xEDble. Han pasado varias promociones y todav\xEDa hay personas que siguen
    discutiendo sobre pol\xEDtica en la biblioteca.\n\nLes record\xE9 que la biblioteca
    es para estudiar. Me dijeron que estaban \"investigando\". Nunca supe si era
    verdad."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
