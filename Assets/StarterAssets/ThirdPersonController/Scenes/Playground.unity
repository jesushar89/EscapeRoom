  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "HOJA 4 - DIARIO DEL BIBLIOTECARIO\n\nS\xE1bado.\n\nAntes de cerrar la
    biblioteca encontr\xE9 \"siete\" libros olvidados sobre una mesa. Tambi\xE9n
    encontr\xE9 una mochila, dos lapiceros, una calculadora y un cuaderno con la
    frase:\n\n\"Ahora s\xED empezar\xE9 a estudiar desde el primer d\xEDa.\"\n\nHe
    le\xEDdo esa misma frase durante tantos a\xF1os que ya deber\xEDa estar archivada
    como patrimonio de la biblioteca.\n\nGuard\xE9 los siete libros en su lugar y
    termin\xE9 mi ronda."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
